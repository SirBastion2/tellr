{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SessionState",
  "description": "Architecture §11.2. CONTRACT_VERSION 2.0.0 (contract-v2). CHANGE-003: Interview = this object + GET /library + the client's last posted chips/purpose (Q-005, Q-010). CHANGE-005: optional nullable explanation and optional context_chips (absent or null/empty on old fixtures). CHANGE-007: optional talk_track.action (imperative teller move; absent on older payloads). session_id is store-assigned; notes/outcome/actor/closed are not projected (Q-011). Cross-field rules (question null only on a hard stop; reasons share the level's direction) live in scripts/check_contract.py (Q-004). Architecture §11.2's T2 example is illustrative; contract/fixtures/T2.json from reference_impl.py is the oracle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "mode",
    "answers",
    "library_version",
    "stated_purpose",
    "risk",
    "question",
    "stop",
    "talk_track",
    "suggested_outcome",
    "available_outcomes"
  ],
  "properties": {
    "session_id": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "live",
        "practice"
      ]
    },
    "answers": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "library_version": {
      "type": "string"
    },
    "stated_purpose": {
      "type": [
        "string",
        "null"
      ]
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "raw_level",
        "score",
        "reasons",
        "counterpoint",
        "pattern",
        "pattern_label"
      ],
      "properties": {
        "level": {
          "enum": [
            "clear",
            "caution",
            "high"
          ]
        },
        "raw_level": {
          "enum": [
            "clear",
            "caution",
            "high"
          ]
        },
        "score": {
          "type": "integer",
          "minimum": -45,
          "maximum": 100
        },
        "reasons": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "rationale"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "rationale": {
                "type": "string"
              }
            }
          }
        },
        "counterpoint": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "rationale"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "rationale": {
              "type": "string"
            }
          }
        },
        "pattern": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "label"
          ],
          "properties": {
            "kind": {
              "enum": [
                "pattern",
                "look_alike"
              ]
            },
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          }
        },
        "pattern_label": {
          "type": "string"
        }
      }
    },
    "question": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "why",
        "kind",
        "chips",
        "stage",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "why": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "open",
            "yes_no"
          ]
        },
        "chips": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "enum": [
              "specific",
              "vague",
              "no_answer",
              "changed",
              "relayed_by_caller",
              "confirmed",
              "denied"
            ]
          }
        },
        "stage": {
          "enum": [
            "opener",
            "verify",
            "probe"
          ]
        },
        "source": {
          "enum": [
            "fixed",
            "rules",
            "model"
          ]
        }
      }
    },
    "stop": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "kind",
        "reason"
      ],
      "properties": {
        "kind": {
          "enum": [
            "hard",
            "recommended"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "talk_track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "pattern",
        "lines",
        "avoid"
      ],
      "properties": {
        "stage": {
          "type": "string"
        },
        "pattern": {
          "type": [
            "string",
            "null"
          ]
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "avoid": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "action": {
          "description": "CHANGE-007. Optional imperative teller move for this step. Not a question. Absent on older payloads.",
          "type": "string"
        }
      }
    },
    "suggested_outcome": {
      "enum": [
        "proceed",
        "slow_down",
        "escalate"
      ]
    },
    "available_outcomes": {
      "const": [
        "proceed",
        "slow_down",
        "escalate",
        "report"
      ]
    },
    "debug": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommender",
        "latency_ms",
        "rejections"
      ],
      "description": "Optional; dropped in production (§11.2). Constrained to these three keys (Q-004). recommender is process settings (boot flag + GET /health), not a log fact (Q-011).",
      "properties": {
        "recommender": {
          "type": "string"
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "rejections": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "explanation": {
      "description": "CHANGE-005 (a). Optional; omit or null on old fixtures. weight values are live library weights (library/signals.yaml as loaded by the API), not reference_impl.py / golden reference_weights.yaml. The rules recommender always returns confidence null. used_fallback is true when the model timed out or was rejected for that turn; derive it from existing debug fields plus the turn's fallback/reject markers — do not add a new write.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "confidence",
        "used_fallback",
        "contributions"
      ],
      "properties": {
        "confidence": {
          "type": [
            "number",
            "null"
          ]
        },
        "used_fallback": {
          "type": "boolean"
        },
        "contributions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "signal_id",
              "label",
              "weight",
              "direction"
            ],
            "properties": {
              "signal_id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "weight": {
                "type": "number"
              },
              "direction": {
                "enum": [
                  "raises",
                  "lowers"
                ]
              }
            }
          }
        }
      }
    },
    "context_chips": {
      "description": "CHANGE-005 (b). Optional echo of live ContextAdded chips so the copilot strip survives reload. Each item is {id, source}. Absent or empty on old fixtures. Score, reasons, and eligibility ignore source (observed and teller chips assert the same signals).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "enum": [
              "observed",
              "teller"
            ]
          }
        }
      }
    }
  }
}

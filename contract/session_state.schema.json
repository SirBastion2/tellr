{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SessionState",
  "description": "Architecture §11.2. CONTRACT_VERSION 1.0.0. CHANGE-003: Interview = this object + GET /library + the client's last posted chips/purpose (Q-005, Q-010). session_id is store-assigned; notes/outcome/actor/closed are not projected (Q-011). Cross-field rules (question null only on a hard stop; reasons share the level's direction) live in scripts/check_contract.py (Q-004). Architecture §11.2's T2 example is illustrative; contract/fixtures/T2.json from reference_impl.py is the oracle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "mode",
    "answers",
    "library_version",
    "stated_purpose",
    "risk",
    "question",
    "stop",
    "talk_track",
    "suggested_outcome",
    "available_outcomes"
  ],
  "properties": {
    "session_id": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "live",
        "practice"
      ]
    },
    "answers": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "library_version": {
      "type": "string"
    },
    "stated_purpose": {
      "type": [
        "string",
        "null"
      ]
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "raw_level",
        "score",
        "reasons",
        "counterpoint",
        "pattern",
        "pattern_label"
      ],
      "properties": {
        "level": {
          "enum": [
            "clear",
            "caution",
            "high"
          ]
        },
        "raw_level": {
          "enum": [
            "clear",
            "caution",
            "high"
          ]
        },
        "score": {
          "type": "integer",
          "minimum": -45,
          "maximum": 100
        },
        "reasons": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "rationale"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "rationale": {
                "type": "string"
              }
            }
          }
        },
        "counterpoint": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "rationale"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "rationale": {
              "type": "string"
            }
          }
        },
        "pattern": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "label"
          ],
          "properties": {
            "kind": {
              "enum": [
                "pattern",
                "look_alike"
              ]
            },
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          }
        },
        "pattern_label": {
          "type": "string"
        }
      }
    },
    "question": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "why",
        "kind",
        "chips",
        "stage",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "why": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "open",
            "yes_no"
          ]
        },
        "chips": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "enum": [
              "specific",
              "vague",
              "no_answer",
              "changed",
              "relayed_by_caller",
              "confirmed",
              "denied"
            ]
          }
        },
        "stage": {
          "enum": [
            "opener",
            "verify",
            "probe"
          ]
        },
        "source": {
          "enum": [
            "fixed",
            "rules",
            "model"
          ]
        }
      }
    },
    "stop": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "kind",
        "reason"
      ],
      "properties": {
        "kind": {
          "enum": [
            "hard",
            "recommended"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "talk_track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "pattern",
        "lines",
        "avoid"
      ],
      "properties": {
        "stage": {
          "type": "string"
        },
        "pattern": {
          "type": [
            "string",
            "null"
          ]
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "avoid": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "suggested_outcome": {
      "enum": [
        "proceed",
        "slow_down",
        "escalate"
      ]
    },
    "available_outcomes": {
      "const": [
        "proceed",
        "slow_down",
        "escalate",
        "report"
      ]
    },
    "debug": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommender",
        "latency_ms",
        "rejections"
      ],
      "description": "Optional; dropped in production (§11.2). Constrained to these three keys (Q-004). recommender is process settings (boot flag + GET /health), not a log fact (Q-011).",
      "properties": {
        "recommender": {
          "type": "string"
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "rejections": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}

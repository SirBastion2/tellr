{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Library",
  "description": "GET /library UI projection (CHANGE-003 / Q-007). Display labels for Interview copy, not the §5 fold library (no weights, asserts_on, tests, characteristic signals, refuters, or purpose routing). contract/library.json is T1–T7 display copy, not the five §5.3 must-have patterns (Q-008); A loads the real backend library. CONTRACT_VERSION 1.0.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "library_version",
    "copy_status",
    "chips",
    "purposes",
    "context_chips",
    "questions",
    "signals",
    "patterns",
    "look_alikes",
    "talk_tracks"
  ],
  "properties": {
    "library_version": {
      "type": "string"
    },
    "copy_status": {
      "type": "string"
    },
    "chips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "used_on"
        ],
        "properties": {
          "id": {
            "enum": [
              "specific",
              "vague",
              "no_answer",
              "changed",
              "relayed_by_caller",
              "confirmed",
              "denied"
            ]
          },
          "label": {
            "type": "string"
          },
          "used_on": {
            "enum": [
              "open",
              "yes_no",
              "any"
            ]
          }
        }
      }
    },
    "purposes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "context_chips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "signal",
          "probe"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "signal": {
            "type": [
              "string",
              "null"
            ]
          },
          "probe": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "intent",
          "kind",
          "role",
          "text",
          "why",
          "chips"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "intent": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "open",
              "yes_no"
            ]
          },
          "role": {
            "enum": [
              "opener",
              "verify",
              "probe"
            ]
          },
          "text": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "chips": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "enum": [
                "specific",
                "vague",
                "no_answer",
                "changed",
                "relayed_by_caller",
                "confirmed",
                "denied"
              ]
            }
          }
        }
      }
    },
    "signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "rationale",
          "direction"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "concern",
              "mitigating"
            ]
          }
        }
      }
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "look_alikes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "pattern"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "pattern": {
            "type": "string"
          }
        }
      }
    },
    "talk_tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "lines",
          "avoid"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "avoid": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
